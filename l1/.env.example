# Copy this file to .env and edit as needed. .env itself is gitignored —
# never commit real credentials.

# --- Local demo (default) — no credentials required ---
# The local Hardhat network needs no API key or private key: the depositor
# wallet in the scripts uses Hardhat's own publicly documented test account
# #1, which only ever holds fake local test ETH.
SAMPLE_RUNS=20

# --- Optional: public testnet (Sepolia) ---
# Only needed if you redeploy scripts/deploy.js to a real network instead of
# the local Hardhat one — see web3-demo/README.md "Why no real testnet or
# mainnet by default". Leave blank for the default local flow; nothing reads
# these unless you add a "sepolia" network entry to hardhat.config.js.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
